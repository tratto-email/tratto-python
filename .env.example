# Copy to .env (gitignored) and fill in. Used only by scripts/staging_smoke.py.

# Test key of the staging workspace. Must start with tratto_test_ — the script
# refuses a live key. Create one in the dashboard, revoke it when you are done.
TRATTO_API_KEY=

# Sender address for the smoke send. On a test key the domain does not need to
# be verified.
TRATTO_FROM_EMAIL=

# Optional. Defaults to https://api-staging.tratto.email
TRATTO_BASE_URL=
